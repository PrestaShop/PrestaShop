services:
  phpmyadmin:
    image: phpmyadmin
    ports:
      - "${PHPMYADMIN_HOST_PORT:-8080}:80"
    environment:
      PMA_HOST: mysql
      PMA_USER: root
      PMA_PASSWORD: blushandbloom
      MYSQL_ROOT_PASSWORD: blushandbloom
    restart: on-failure
    depends_on:
      - mysql
    networks:
      - blush-and-bloom-beauty-network
  blushandbloom-git:
      environment:
        # BLACKFIRE_ENABLE: 1
        # BLACKFIRE_SERVER_ID: "your_server_id"
        # BLACKFIRE_SERVER_TOKEN: "your_blackfire_server_token"
