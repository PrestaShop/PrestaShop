{% form_theme shopUrlForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

<div class="row">
  <div class="col-lg-4">
    {{ include('@PrestaShop/Admin/Configure/AdvancedParameters/Multistore/Blocks/shop_tree.html.twig') }}
  </div>
  <div class="col-lg-8">
    {{ form_start(shopUrlForm) }}
    {{ form_widget(shopUrlForm) }}
    <div class="card">
      <div class="card-footer">
        <a href="{{ path('admin_shop_urls_index') }}" class="btn btn-outline-secondary">
          {{ 'Cancel'|trans({}, 'Admin.Actions') }}
        </a>
        <button class="btn btn-primary float-right" id="save-button">
          {{ 'Save'|trans({}, 'Admin.Actions') }}
        </button>
      </div>
    </div>
    {{ form_end(shopUrlForm) }}
  </div>
</div>
