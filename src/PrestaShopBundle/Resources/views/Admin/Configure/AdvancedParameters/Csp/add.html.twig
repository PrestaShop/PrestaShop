{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Admin.Advparameters.Feature' %}

{% block content %}
  {{ form_start(addCspRuleForm, {attr: {class: 'form'}, action: path('admin_security_headers_add')}) }}
    <div class="card">
      <h3 class="card-header">
        <i class="material-icons">add_circle_outline</i> {{ 'Add allowed source'|trans({}, 'Admin.Advparameters.Feature') }}
      </h3>
      <div class="card-body">
        <div class="form-wrapper">
          {{ form_widget(addCspRuleForm) }}
          {{ form_rest(addCspRuleForm) }}
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-between">
          <a href="{{ path('admin_security_headers_index') }}" class="btn btn-outline-secondary">
            {{ 'Cancel'|trans({}, 'Admin.Actions') }}
          </a>
          <button type="submit" class="btn btn-primary">{{ 'Add'|trans({}, 'Admin.Advparameters.Feature') }}</button>
        </div>
      </div>
    </div>
  {{ form_end(addCspRuleForm) }}
{% endblock %}
