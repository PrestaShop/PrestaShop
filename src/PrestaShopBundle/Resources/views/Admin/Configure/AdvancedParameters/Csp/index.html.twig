{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Admin.Advparameters.Feature' %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('themes/new-theme/public/csp.bundle.js') }}"></script>
{% endblock %}

{% block content %}
  {% if cspHasWeakeningSources %}
    <div class="alert alert-warning" role="alert">
      <p class="alert-text">
        {% if cspIsEnforcing %}
          {{ 'Your allow-list contains sources that weaken the policy (such as \'unsafe-inline\' or \'unsafe-eval\'). While the policy is enforced with these, it gives limited protection against cross-site scripting.'|trans({}, 'Admin.Advparameters.Notification') }}
        {% else %}
          {{ 'Your allow-list contains sources that weaken the policy (such as \'unsafe-inline\' or \'unsafe-eval\'). If you enforce it as is, it will give limited protection against cross-site scripting.'|trans({}, 'Admin.Advparameters.Notification') }}
        {% endif %}
      </p>
    </div>
  {% endif %}

  {{ form_start(cspForm, {attr: {class: 'form'}, action: path('admin_security_csp_save')}) }}
    <div class="card" id="configuration_fieldset_csp">
      <h3 class="card-header">
        <i class="material-icons">security</i> {{ 'Content Security Policy'|trans({}, 'Admin.Advparameters.Feature') }}
      </h3>
      <div class="card-body">
        <div class="form-wrapper">
          {{ form_widget(cspForm) }}
          {{ form_rest(cspForm) }}
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
        </div>
      </div>
    </div>
  {{ form_end(cspForm) }}

  {{ include('@PrestaShop/Admin/Common/Grid/grid_panel.html.twig', {grid: cspLogGrid}) }}
{% endblock %}
