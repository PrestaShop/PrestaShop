{% extends '@PrestaShop/Admin/layout.html.twig' %}
{% trans_default_domain 'Admin.Advparameters.Feature' %}

{% block javascripts %}
  {{ parent() }}
  <script src="{{ asset('themes/new-theme/public/csp.bundle.js') }}"></script>
{% endblock %}

{% block content %}
  {{ form_start(securityHeadersForm, {attr: {class: 'form'}, action: path('admin_security_headers_save')}) }}
    <div class="card" id="configuration_fieldset_security_headers">
      <h3 class="card-header">
        <i class="material-icons">lock</i> {{ 'Security headers'|trans({}, 'Admin.Advparameters.Feature') }}
      </h3>
      <div class="card-body">
        <p class="text-muted">
          {{ 'Static response headers, set per shop and sent on both the storefront and back office. Content Security Policy is managed separately below.'|trans({}, 'Admin.Advparameters.Help') }}
        </p>
        <div class="form-wrapper">
          {{ form_widget(securityHeadersForm) }}
          {{ form_rest(securityHeadersForm) }}
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
        </div>
      </div>
    </div>
  {{ form_end(securityHeadersForm) }}

  <h2 class="mt-2">{{ 'Content Security Policy'|trans({}, 'Admin.Advparameters.Feature') }}</h2>
  <ul class="nav nav-tabs mb-2" role="tablist">
    <li class="nav-item">
      <a class="nav-link{{ cspSelectedContext == 'front' ? ' active' : '' }}" href="{{ path('admin_security_headers_index') }}">
        {{ 'Storefront'|trans({}, 'Admin.Shopparameters.Feature') }}
      </a>
    </li>
    <li class="nav-item">
      <a class="nav-link{{ cspSelectedContext == 'admin' ? ' active' : '' }}" href="{{ path('admin_security_headers_index', {context: 'admin'}) }}">
        {{ 'Back office'|trans({}, 'Admin.Advparameters.Feature') }}
      </a>
    </li>
  </ul>

  {% if cspShowEnforceNudge %}
    <div class="alert alert-info" role="alert">
      <p class="alert-text">
        {{ '%count% reported source(s) are not yet on your allow-list. If you turn off report-only mode now, they will be blocked. Review them in the log below and allow the ones your site needs first.'|trans({'%count%': cspUnreviewedCount}, 'Admin.Advparameters.Notification') }}
      </p>
    </div>
  {% endif %}

  {% if cspHasWeakeningSources %}
    <div class="alert alert-warning" role="alert">
      <p class="alert-text">
        {% if cspIsEnforcing %}
          {{ 'Your allow-list contains sources that weaken the policy (such as \'unsafe-inline\' or \'unsafe-eval\'). The policy is enforced, but allowing \'unsafe-inline\' means it no longer protects against inline-script cross-site scripting.'|trans({}, 'Admin.Advparameters.Notification') }}
        {% else %}
          {{ 'Your allow-list contains sources that weaken the policy (such as \'unsafe-inline\' or \'unsafe-eval\'). If you enforce it as is, allowing \'unsafe-inline\' means it will not protect against inline-script cross-site scripting.'|trans({}, 'Admin.Advparameters.Notification') }}
        {% endif %}
      </p>
    </div>
  {% endif %}

  {{ form_start(cspForm, {attr: {class: 'form'}, action: path('admin_security_headers_csp_save', cspContextParams)}) }}
    <div class="card" id="configuration_fieldset_csp">
      <h3 class="card-header">
        <i class="material-icons">security</i> {{ 'Content Security Policy'|trans({}, 'Admin.Advparameters.Feature') }}
      </h3>
      <div class="card-body">
        <div class="form-wrapper">
          {{ form_widget(cspForm) }}
          {{ form_rest(cspForm) }}
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex justify-content-end">
          <button type="submit" class="btn btn-primary">{{ 'Save'|trans({}, 'Admin.Actions') }}</button>
        </div>
      </div>
    </div>
  {{ form_end(cspForm) }}

  {{ include('@PrestaShop/Admin/Common/Grid/grid_panel.html.twig', {grid: cspLogGrid}) }}
{% endblock %}
