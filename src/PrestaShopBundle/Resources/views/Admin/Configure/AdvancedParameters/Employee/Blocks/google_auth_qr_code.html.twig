<div class="form-group row select-widget">

    <label class="form-control-label"></label>

    <div class="col-sm input-container">
        <h3>{{ 'Two-factor authentication'|trans({}, 'Admin.Advparameters.Notification') }}</h3>
        {% if not twoFactorEnabled %}
            <p>
                {{ 'Scan the following QR code with the "Google Authenticator" app to generate an account and enter the generated verification code in the "Verification code" field to activate the account.'|trans({}, 'Admin.Advparameters.Notification') }}<br/>
                {{ 'If an account is already active, repeating the process will generate and activate a new account.'|trans({}, 'Admin.Advparameters.Notification') }}
            </p>
            <img src="{{ qrCodeSrc }}">
        {% else %}
            {{ 'Two-factor authentication is already activated for this account.'|trans({}, 'Admin.Advparameters.Notification') }}
        {% endif %}
    </div>
</div>