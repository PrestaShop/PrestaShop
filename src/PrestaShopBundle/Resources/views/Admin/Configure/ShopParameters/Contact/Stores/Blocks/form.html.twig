{% form_theme storeForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block store_form %}
  {{ form_start(storeForm, {attr: {enctype: 'multipart/form-data'}}) }}
    <div class="card">
      <h3 class="card-header">
        <i class="material-icons">store</i>
        {{ 'Store'|trans({}, 'Admin.Shopparameters.Feature') }}
      </h3>
      <div class="card-body">
        <div class="form-wrapper">
          {% for child in storeForm %}
            {{ form_row(child) }}
            {% if child.vars.name == 'image' and storeImage is defined and storeImage is not null %}
              <div class="form-group row">
                <label class="form-control-label col-sm-2"></label>
                <div class="col-sm">
                  {{ include('@PrestaShop/Admin/Configure/ShopParameters/Contact/Stores/store_image.html.twig') }}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
      <div class="card-footer">
        <a href="{{ path('admin_stores_index') }}" class="btn btn-outline-secondary">
          {{ 'Cancel'|trans({}, 'Admin.Actions') }}
        </a>
        <button class="btn btn-primary float-right" id="save-button">
          {{ 'Save'|trans({}, 'Admin.Actions') }}
        </button>
      </div>
    </div>
  {{ form_end(storeForm) }}
{% endblock %}
