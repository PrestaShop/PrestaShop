{% form_theme customerGroupForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{{ form_start(customerGroupForm) }}

<div class="card">
  <h3 class="card-header">
    {{ 'Group'|trans({}, 'Admin.Global') }}
  </h3>

  <div class="card-body">
    <div class="form-wrapper">
      {{ form_errors(customerGroupForm) }}
      {{ form_row(customerGroupForm) }}
    </div>
  </div>
</div>

<div class="card-footer mt-3">
  <div class="d-inline-flex">
    <a href="{{ path('admin_customer_groups_index') }}" class="btn btn-outline-secondary">
      {{ 'Cancel'|trans({}, 'Admin.Actions') }}
    </a>
  </div>
  <div class="d-inline-flex float-right">
    <button class="btn btn-primary" id="save-button" type="submit">
      {{ 'Save'|trans({}, 'Admin.Actions') }}
    </button>
  </div>
</div>

{{ form_end(customerGroupForm) }}
