{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block content %}
  {% if showDisabledFeatureWarning %}
    {{ include('@PrestaShop/Admin/Sell/Catalog/Features/Blocks/disabled_feature_warning.html.twig') }}
  {% else %}
    {% block default_groups_info %}
      <div class="alert alert-info" role="alert">
        <p class="alert-text">{{ 'PrestaShop has three default customer groups:'|trans({}, 'Admin.Shopparameters.Help') }}</p>
        <ul>
          <li>{{ '%group_name% - All persons without a customer account or customers that are not logged in.'|trans({'%group_name%': '<strong>' ~ defaultGroupNames.visitors|e ~ '</strong>'}, 'Admin.Shopparameters.Help')|raw_purified }}</li>
          <li>{{ '%group_name% - All persons who placed an order through Guest Checkout.'|trans({'%group_name%': '<strong>' ~ defaultGroupNames.guests|e ~ '</strong>'}, 'Admin.Shopparameters.Help')|raw_purified }}</li>
          <li>{{ '%group_name% - All persons who created an account on this site.'|trans({'%group_name%': '<strong>' ~ defaultGroupNames.customers|e ~ '</strong>'}, 'Admin.Shopparameters.Help')|raw_purified }}</li>
        </ul>
      </div>
    {% endblock %}

    {% block groups_list_panel %}
      {{ include('@PrestaShop/Admin/Common/Grid/grid_panel.html.twig', {grid: customerGroupsGrid}) }}
    {% endblock %}

    {% block default_groups_options %}
      {{ include('@PrestaShop/Admin/Configure/ShopParameters/CustomerSettings/Groups/Blocks/default_groups_options.html.twig') }}
    {% endblock %}
  {% endif %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script src="{{ asset('themes/new-theme/public/customer_groups.bundle.js') }}"></script>
  <script src="{{ asset('themes/default/js/bundle/pagination.js') }}"></script>
{% endblock %}
