{% block password_feedback_block %}
  <template id="password-feedback">
    {# Password strength feedback messages - used in JS #}
    <div
      class="password-strength-feedback d-none"
      {# Warnings and suggestions are indexed by zxcvbn-ts message keys, they are injected into
         zxcvbn-ts options so that the library directly returns translated feedback messages. #}
      data-translations="{{ {
                           0: 'Very weak'|trans({}, 'Admin.Advparameters.Feature'),
                           1: 'Weak'|trans({}, 'Admin.Advparameters.Feature'),
                           2: 'Average'|trans({}, 'Admin.Advparameters.Feature'),
                           3: 'Strong'|trans({}, 'Admin.Advparameters.Feature'),
                           4: 'Very strong'|trans({}, 'Admin.Advparameters.Feature'),
                           'warnings': {
                             'straightRow': 'Straight rows of keys are easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'keyPattern': 'Short keyboard patterns are easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'simpleRepeat': 'Repeats like "aaa" are easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'extendedRepeat': 'Repeats like "abcabcabc" are only slightly harder to guess than "abc"'|trans({}, 'Admin.Advparameters.Feature'),
                             'sequences': 'Sequences like "abc" or "6543" are easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'recentYears': 'Recent years are easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'dates': 'Dates are often easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'topTen': 'This is a top-10 common password'|trans({}, 'Admin.Advparameters.Feature'),
                             'topHundred': 'This is a top-100 common password'|trans({}, 'Admin.Advparameters.Feature'),
                             'common': 'This is a very common password'|trans({}, 'Admin.Advparameters.Feature'),
                             'similarToCommon': 'This is similar to a commonly used password'|trans({}, 'Admin.Advparameters.Feature'),
                             'wordByItself': 'A word by itself is easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'namesByThemselves': 'Names and surnames by themselves are easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'commonNames': 'Common names and surnames are easy to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'userInputs': 'Avoid personal information such as your name or your email address'|trans({}, 'Admin.Advparameters.Feature'),
                             'pwned': 'This password was exposed by a data breach on the Internet'|trans({}, 'Admin.Advparameters.Feature'),
                           },
                           'suggestions': {
                             'l33t': 'Predictable substitutions like "@" instead of "a" don\'t help very much'|trans({}, 'Admin.Advparameters.Feature'),
                             'reverseWords': 'Reversed words aren\'t much harder to guess'|trans({}, 'Admin.Advparameters.Feature'),
                             'allUppercase': 'All-uppercase is almost as easy to guess as all-lowercase'|trans({}, 'Admin.Advparameters.Feature'),
                             'capitalization': 'Capitalization doesn\'t help very much'|trans({}, 'Admin.Advparameters.Feature'),
                             'dates': 'Avoid dates and years that are associated with you'|trans({}, 'Admin.Advparameters.Feature'),
                             'recentYears': 'Avoid recent years'|trans({}, 'Admin.Advparameters.Feature'),
                             'associatedYears': 'Avoid years that are associated with you'|trans({}, 'Admin.Advparameters.Feature'),
                             'sequences': 'Avoid sequences'|trans({}, 'Admin.Advparameters.Feature'),
                             'repeated': 'Avoid repeated words and characters'|trans({}, 'Admin.Advparameters.Feature'),
                             'longerKeyboardPattern': 'Use a longer keyboard pattern with more turns'|trans({}, 'Admin.Advparameters.Feature'),
                             'anotherWord': 'Add another word or two. Uncommon words are better.'|trans({}, 'Admin.Advparameters.Feature'),
                             'useWords': 'Use a few words, avoid common phrases'|trans({}, 'Admin.Advparameters.Feature'),
                             'noNeed': 'No need for symbols, digits, or uppercase letters'|trans({}, 'Admin.Advparameters.Feature'),
                             'pwned': 'If you use this password elsewhere, you should change it'|trans({}, 'Admin.Advparameters.Feature'),
                           },
                           }|json_encode|escape('html_attr') }}"
    >
      <div class="progress-container">
        <div class="progress-bar">
          <div></div>
        </div>
      </div>
      <div class="password-strength-text"></div>
      <div class="password-requirements">
        <p class="password-requirements-length" data-translation="{{ ('Enter a password between %d and %d characters'|trans({}, 'Admin.Advparameters.Feature'))|escape('html_attr') }}">
          <i class="material-icons">check_circle</i>
          <span></span>
        </p>
        <p class="password-requirements-score" data-translation="{{ ('The minimum score must be: %s'|trans({}, 'Admin.Advparameters.Feature'))|escape('html_attr') }}">
          <i class="material-icons">check_circle</i>
          <span></span>
        </p>
      </div>
    </div>
  </template>
{% endblock %}
