{# The dialog fits the screen height, only the list scrolls between the search and the pagination #}
{% embed '@PrestaShop/Admin/Helpers/bootstrap_popup.html.twig' with {
  id: 'associated-products-modal',
  class: 'modal-lg modal-dialog-scrollable',
  title: 'Products'|trans({}, 'Admin.Global'),
  closable: true,
} %}
  {% block content %}
    <div class="px-3 pt-3">
      <input
        type="search"
        class="form-control js-associated-products-search"
        placeholder="{{ 'Search by ID, reference or name'|trans({}, 'Admin.Catalog.Feature') }}"
        aria-label="{{ 'Search by ID, reference or name'|trans({}, 'Admin.Catalog.Feature') }}"
      >
    </div>
    <div class="modal-body">
      <p class="js-associated-products-loading d-none">{{ 'Loading...'|trans({}, 'Admin.Global') }}</p>
      <p class="js-associated-products-error alert alert-danger d-none">{{ 'An error occurred while loading the products.'|trans({}, 'Admin.Catalog.Notification') }}</p>
      <div class="js-associated-products-table d-none">
        <table class="table mb-0">
          <thead class="sticky-top bg-white">
            <tr>
              <th>{{ 'ID'|trans({}, 'Admin.Global') }}</th>
              <th>{{ 'Reference'|trans({}, 'Admin.Global') }}</th>
              <th>{{ 'Name'|trans({}, 'Admin.Global') }}</th>
              <th class="text-center">{{ 'Status'|trans({}, 'Admin.Global') }}</th>
            </tr>
          </thead>
          <tbody
            data-enabled-label="{{ 'Enabled'|trans({}, 'Admin.Global') }}"
            data-disabled-label="{{ 'Disabled'|trans({}, 'Admin.Global') }}"
          ></tbody>
        </table>
        <p class="text-muted mt-3 d-none js-associated-products-no-match">{{ 'No products match this search.'|trans({}, 'Admin.Catalog.Notification') }}</p>
      </div>
    </div>
  {% endblock %}

  {% block footer %}
    <div class="modal-footer justify-content-center d-none" id="associated-products-pagination">
      {{ include('@PrestaShop/Admin/Common/javascript_pagination.html.twig', {
        limit: 25,
        limitChoices: [25, 50, 100],
      }) }}
    </div>
  {% endblock %}
{% endembed %}
