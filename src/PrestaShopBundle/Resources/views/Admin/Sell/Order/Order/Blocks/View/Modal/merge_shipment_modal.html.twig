<div class="modal fade" id="mergeShipmentModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    {{ form_start(mergeShipmentForm, {
      action: path('admin_orders_merge_shipment', {orderId: orderForViewing.id})
    }) }}
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ 'Merge shipment'|trans({}, 'Admin.Orderscustomers.Feature') }}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close'|trans({}, 'Admin.Actions') }}">
          <span aria-hidden="true">×</span>
        </button>
      </div>

      <div class="modal-body">
        <p>
          {{ 'Select items to merge'|trans({}, 'Admin.Orderscustomers.Feature') }}
          <i class="material-icons" data-toggle="tooltip" title="{{ 'These items will be added to another shipment'|trans }}">help_outline</i>
        </p>

        <table class="table table-borderless">
          <thead>
            <tr>
              <th>{{ 'Products'|trans }}</th>
              <th class="text-right">{{ 'Select quantity'|trans }}</th>
            </tr>
          </thead>
          <tbody>
            {% for product in mergeShipmentForm.products %}
              <tr>
                <td>
                  <div class="form-check">
                    {{ form_widget(product.selected, { attr: {'class': 'form-check-input'} }) }}
                    <label class="form-check-label">
                      <strong>{{ product.name.vars.value }}</strong><br>
                      <small>{{ 'Reference:'|trans }} {{ product.reference.vars.value }}</small>
                    </label>
                  </div>
                </td>
                <td class="text-right">
                  {{ form_widget(product.quantity) }}
                  <span>/{{ product.max_quantity.vars.value }}</span>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="form-group mt-4">
          <label>{{ 'Select shipment to merge to'|trans({}, 'Admin.Orderscustomers.Feature') }}</label>
          <i class="material-icons" data-toggle="tooltip" title="{{ 'Choose the existing shipment where items will be merged'|trans }}">help_outline</i>
          {{ form_widget(mergeShipmentForm.merge_to_shipment, { attr: {'class': 'form-control'} }) }}
        </div>

        {{ form_rest(mergeShipmentForm) }}
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
          {{ 'Cancel'|trans({}, 'Admin.Actions') }}
        </button>
        <button type="submit" class="btn btn-primary" id="submitMergeShipment" disabled>
          {{ 'Merge shipment'|trans({}, 'Admin.Actions') }}
        </button>
      </div>
    </div>
    {{ form_end(mergeShipmentForm) }}
  </div>
</div>
