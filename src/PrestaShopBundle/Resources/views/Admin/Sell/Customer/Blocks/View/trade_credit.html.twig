{% macro trade_credit_amount(amount, tradeCredit) %}
  {%- if tradeCredit.currencyInstalled -%}
    {{ (amount ~ '')|price_format(tradeCredit.currencyIso) }}
  {%- else -%}
    {{ (amount ~ '')|number_format(2, '.', ',') }} {{ tradeCredit.currencyIso }}
  {%- endif -%}
{% endmacro %}

{% if customerTradeCredit is defined and customerTradeCredit is not null %}
  {% import _self as tradeCreditHelper %}
  {% set operationLabels = {
    'grant': 'Granted'|trans({}, 'Admin.Orderscustomers.Feature'),
    'debit': 'Order'|trans({}, 'Admin.Global'),
    'release': 'Order cancelled before creation'|trans({}, 'Admin.Orderscustomers.Feature'),
    'refund': 'Refund'|trans({}, 'Admin.Orderscustomers.Feature'),
    'adjustment': 'Adjustment by employee'|trans({}, 'Admin.Orderscustomers.Feature'),
  } %}

  <div class="card customer-trade-credit-card">
    <h3 class="card-header">
      <i class="material-icons">account_balance_wallet</i>
      {{ 'Trade credit'|trans({}, 'Admin.Orderscustomers.Feature') }}
    </h3>
    <div class="card-body">
      <p class="customer-trade-credit-balance">
        {% if customerTradeCredit.granted %}
          {{ 'Available trade credit:'|trans({}, 'Admin.Orderscustomers.Feature') }}
          <strong>{{ tradeCreditHelper.trade_credit_amount(customerTradeCredit.balance, customerTradeCredit) }}</strong>
        {% else %}
          {{ 'Not granted yet. The customer will receive %amount% with the first trade credit order.'|trans({'%amount%': tradeCreditHelper.trade_credit_amount(customerTradeCredit.defaultAmount, customerTradeCredit)}, 'Admin.Orderscustomers.Feature') }}
        {% endif %}
      </p>

      {% if customerTradeCredit.operations is not empty %}
        <table class="table">
          <thead>
          <tr>
            <th>{{ 'Date'|trans({}, 'Admin.Global') }}</th>
            <th>{{ 'Operation'|trans({}, 'Admin.Orderscustomers.Feature') }}</th>
            <th class="text-right">{{ 'Amount'|trans({}, 'Admin.Global') }}</th>
            <th class="text-right">{{ 'Balance'|trans({}, 'Admin.Orderscustomers.Feature') }}</th>
            <th>{{ 'Order'|trans({}, 'Admin.Global') }}</th>
          </tr>
          </thead>
          <tbody>
          {% for operation in customerTradeCredit.operations %}
            <tr class="customer-trade-credit-operation">
              <td>{{ operation.date|date('Y-m-d H:i') }}</td>
              <td>{{ operationLabels[operation.type]|default(operation.type) }}</td>
              <td class="text-right">{{ tradeCreditHelper.trade_credit_amount(operation.amount, customerTradeCredit) }}</td>
              <td class="text-right">{{ tradeCreditHelper.trade_credit_amount(operation.balanceAfter, customerTradeCredit) }}</td>
              <td>
                {% if operation.orderId %}
                  <a href="{{ path('admin_orders_view', {orderId: operation.orderId}) }}">#{{ operation.orderId }}</a>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
      {% endif %}
    </div>
  </div>
{% endif %}
