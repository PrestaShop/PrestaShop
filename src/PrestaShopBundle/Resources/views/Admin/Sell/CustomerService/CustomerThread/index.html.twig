{% extends '@PrestaShop/Admin/layout.html.twig' %}

{% block stylesheets %}
  {{ parent() }}
  <link rel="stylesheet" href="{{ asset('themes/new-theme/public/customer_threads' ~ rtl_suffix ~ '.css') }}" type="text/css" media="all">
{% endblock %}

{% block content %}
  {% block customer_service_kpis %}
    {{ render(controller(
      'PrestaShopBundle\\Controller\\Admin\\CommonController::renderKpiRowAction',
      {kpiRow: customerServiceKpi},
    )) }}
  {% endblock %}

  {% block customer_service_statistics_row %}
    <div class="row mb-3">
      {{ include(
        '@PrestaShop/Admin/Sell/CustomerService/CustomerThread/Block/contact_categories_statistics.html.twig',
        {categories: customerServiceContactCategoriesStatistics},
      ) }}
      {{ include(
        '@PrestaShop/Admin/Sell/CustomerService/CustomerThread/Block/listing_statistics.html.twig',
        {statistics: customerServiceListingStatistics},
      ) }}
    </div>
  {% endblock %}

  {{ include('@PrestaShop/Admin/Common/Grid/grid_panel.html.twig', {grid: customerThreadGrid}) }}

  {% block customer_service_options %}
    {{ include('@PrestaShop/Admin/Sell/CustomerService/CustomerThread/Block/options.html.twig') }}
  {% endblock %}
{% endblock %}

{% block javascripts %}
  {{ parent() }}

  <script src="{{ asset('themes/new-theme/public/customer_thread.bundle.js') }}"></script>
  <script src="{{ asset('themes/default/js/bundle/pagination.js') }}"></script>
{% endblock %}
