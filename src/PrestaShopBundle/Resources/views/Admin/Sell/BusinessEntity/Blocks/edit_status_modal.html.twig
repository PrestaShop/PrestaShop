<div class="modal fade" id="editBusinessEntityStatusModal" tabindex="-1" role="dialog">
  <div class="modal-dialog" role="document">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">{{ 'Edit status'|trans({}, 'Admin.Orderscustomers.Feature') }}</h5>
        <button type="button" class="close" data-dismiss="modal" aria-label="{{ 'Close'|trans({}, 'Admin.Actions') }}">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>

      <div class="modal-body">
        {{ include('@PrestaShop/Admin/Sell/BusinessEntity/Blocks/Skeletons/edit_status_skeleton.html.twig') }}

        <div class="alert alert-danger d-none" id="editBusinessEntityStatusError" role="alert">
          <p class="alert-text">{{ 'An error occurred while loading the status form.'|trans({}, 'Admin.Notifications.Error') }}</p>
        </div>
        <div class="alert alert-danger d-none" id="editBusinessEntityStatusSavingError" role="alert">
          <p class="alert-text">{{ 'An error occurred while updating the status.'|trans({}, 'Admin.Notifications.Error') }}</p>
        </div>
        <div id="editBusinessEntityStatusFormContainer"></div>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">
          {{ 'Cancel'|trans({}, 'Admin.Actions') }}
        </button>
        <button type="submit" class="btn btn-primary" id="submitEditBusinessEntityStatus" form="edit_business_entity_status_form" disabled>
          {{ 'Update status'|trans({}, 'Admin.Orderscustomers.Feature') }}
        </button>
      </div>
    </div>
  </div>
</div>
