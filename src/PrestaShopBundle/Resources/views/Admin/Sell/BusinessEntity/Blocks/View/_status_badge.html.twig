{% set badgeType = {
  active: 'success',
  pending: 'info',
  inactive: 'light-info',
  rejected: 'danger',
}[businessEntity.status]|default('') %}

<span class="badge rounded badge-{{ badgeType }}{{ extraClass is defined ? ' ' ~ extraClass }}">{{ businessEntity.statusLabel }}</span>
