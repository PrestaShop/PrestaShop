{% form_theme form '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}

{% block customer_b2b_form %}
  {{ form_start(form) }}
  <div class="card">
    <h3 class="card-header">
      {{ 'Fill in your B2B customer\'s information'|trans({}, 'Admin.Orderscustomers.Feature') }}
    </h3>

    <div class="card-body">
      <div class="form-wrapper">
        {{ form_errors(form) }}

        {% if form.use_existing_customer is defined %}
          {% set usesExistingCustomer = form.use_existing_customer.vars.data %}

          {{ form_row(form.use_existing_customer) }}

          <div id="customer_b2b_new_customer_section"{% if usesExistingCustomer %} class="d-none"{% endif %}>
            {{ form_row(form.customer) }}
            {{ form_row(form.send_password_setup_link) }}
          </div>

          <div id="customer_b2b_existing_customer_section"{% if not usesExistingCustomer %} class="d-none"{% endif %}>
            {{ form_row(form.existing_customer) }}
          </div>
        {% else %}
          {{ form_row(form.customer) }}
        {% endif %}

        {% if form.business_entity_id is defined %}
          {{ form_row(form.business_entity_id) }}

          {% if is_granted('create', 'AdminBusinessEntities') %}
            <div class="form-group row">
              <div class="form-control-label"></div>
              <div class="col-sm input-container">
                <div class="alert alert-info" role="alert">
                  <div class="d-flex justify-content-between align-items-center">
                    <div>
                      <p class="alert-text font-weight-bold">
                        {{ 'The business entity you are looking for doesn\'t exist?'|trans({}, 'Admin.Orderscustomers.Feature') }}
                      </p>
                      <p class="alert-text">
                        {{ 'You\'ll be redirected to the business entity\'s creation form and the fields you\'ve filled here won\'t be saved.'|trans({}, 'Admin.Orderscustomers.Help') }}
                      </p>
                    </div>
                    <a href="{{ path('admin_business_entities_create') }}" class="btn btn-outline-secondary ml-3 text-nowrap">
                      {{ 'Create it'|trans({}, 'Admin.Orderscustomers.Feature') }}
                    </a>
                  </div>
                </div>
              </div>
            </div>
          {% endif %}
        {% endif %}

        {{ form_rest(form) }}
      </div>
    </div>

    <div class="card-footer">
      <a href="{{ path('admin_customer_b2b_list') }}" class="btn btn-outline-secondary">
        {{ 'Cancel'|trans({}, 'Admin.Actions') }}
      </a>

      <button type="submit" class="btn btn-primary float-right" id="save-button">
        {{ 'Save'|trans({}, 'Admin.Actions') }}
      </button>
    </div>
  </div>
  {{ form_end(form) }}
{% endblock %}
