{% form_theme importLanguagePackForm '@PrestaShop/Admin/TwigTemplateForm/prestashop_ui_kit.html.twig' %}
{% trans_default_domain 'Admin.International.Feature' %}

{{ form_start(importLanguagePackForm, {action: path('admin_international_translations_import_language_pack')}) }}

<div class="card import-translations">
  <h3 class="card-header">
    <i class="material-icons">cloud_upload</i> {{ 'Import a language pack'|trans }}

    <span
      class="help-box"
      data-container="body"
      data-toggle="popover"
      data-trigger="hover"
      data-placement="right"
      data-content="{{ 'Load a language pack you exported earlier, or one you obtained from the translation project, into an already installed language.'|trans({}, 'Admin.International.Help') }}"
      title=""
    >
    </span>
  </h3>
  <div class="card-body">
    <div class="form-wrapper">
      {{ form_rest(importLanguagePackForm) }}
    </div>
  </div>

  <div class="card-footer">
    <div class="d-flex justify-content-end">
      <button class="btn btn-primary" id="form-import-language-pack-button">
        <i class="material-icons">cloud_upload</i>
        <span>{{ 'Import'|trans({}, 'Admin.Actions') }}</span>
      </button>
    </div>
  </div>
</div>

{{ form_end(importLanguagePackForm) }}
