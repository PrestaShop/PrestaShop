{#
 # Renders the canvas/JSON pair documented in dashboardCharts.ts from a plain Chart.js config
 # array (not a JSON string) — the module doesn't need to think about JSON_HEX_TAG/JSON_HEX_AMP,
 # this macro is the only place that has to. `maintainAspectRatio: false` is forced so the
 # `height` option (px) actually takes effect: Chart.js is responsive by default and otherwise
 # recomputes the height from `aspectRatio`, ignoring any explicit canvas height.
 #}
{% macro renderChart(chartId, config, options) %}
  {% set height = options.height|default(200) %}
  {% set mergedConfig = config|merge({
    options: (config.options|default({}))|merge({maintainAspectRatio: false}),
  }) %}
  <div style="position: relative; height: {{ height }}px;">
    <canvas id="{{ chartId }}" data-chart role="img"></canvas>
  </div>
  <script type="application/json" id="{{ chartId }}-data">{{ mergedConfig|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }}</script>
{% endmacro %}
