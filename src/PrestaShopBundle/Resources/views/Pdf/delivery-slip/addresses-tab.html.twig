{# Shared by DeliverySlip and ShipmentDeliverySlip (see legacy pdf/delivery-slip.addresses-tab.tpl). #}
<table id="addresses-tab" cellspacing="0" cellpadding="0">
    <tr>
        <td width="33%">
            <span class="bold"> </span><br/><br/>
            {{ shop_address|raw }}
        </td>
        {% if invoice_address %}
            <td width="33%">
                {% if delivery_address %}
                    <span class="bold">{{ 'Delivery address'|trans({}, 'Shop.Pdf') }}</span><br/><br/>
                    {{ delivery_address|raw }}
                {% endif %}
            </td>
            <td width="33%">
                <span class="bold">{{ 'Billing address'|trans({}, 'Shop.Pdf') }}</span><br/><br/>
                {{ invoice_address|raw }}
            </td>
        {% else %}
            <td width="66%">
                {% if delivery_address %}
                    <span class="bold">{{ 'Billing & Delivery Address'|trans({}, 'Shop.Pdf') }}</span><br/><br/>
                    {{ delivery_address|raw }}
                {% endif %}
            </td>
        {% endif %}
    </tr>
</table>
