{{ style_tab|raw }}

<table width="100%" id="body" border="0" cellpadding="0" cellspacing="0" style="margin:0;">
    {# Invoicing #}
    <tr>
        <td colspan="12">
            {{ addresses_tab|raw }}
        </td>
    </tr>

    <tr>
        <td colspan="12" height="30">&nbsp;</td>
    </tr>

    {# TVA Info #}
    <tr>
        <td colspan="12">
            {{ summary_tab|raw }}
        </td>
    </tr>

    <tr>
        <td colspan="12" height="20">&nbsp;</td>
    </tr>

    {# Product #}
    <tr>
        <td colspan="12">
            {{ product_tab|raw }}
        </td>
    </tr>

    <tr>
        <td colspan="12" height="10">&nbsp;</td>
    </tr>

    {# TVA #}
    <tr>
        <td colspan="6" class="left">
            {{ tax_tab|raw }}
        </td>
        <td colspan="1">&nbsp;</td>
        <td colspan="5" rowspan="5" class="right">
            {{ total_tab|raw }}
        </td>
    </tr>

    <tr>
        <td colspan="12" height="10">&nbsp;</td>
    </tr>

    <tr>
        <td colspan="6" class="left">
            {{ payment_tab|raw }}
        </td>
        <td colspan="1">&nbsp;</td>
    </tr>

    {% if hook_display_pdf %}
        <tr>
            <td colspan="12" height="30">&nbsp;</td>
        </tr>

        <tr>
            <td colspan="12">
                {{ hook_display_pdf|raw }}
            </td>
        </tr>
    {% endif %}
</table>
