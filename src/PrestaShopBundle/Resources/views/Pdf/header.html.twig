{# Shared by every PDF document type (invoice, credit slip, order return, delivery slip...). #}
<table style="width: 100%">
    <tr>
        <td style="width: 50%">
            {% if logo_path %}
                <img src="{{ logo_path }}" style="width:{{ width_logo }}px; height:{{ height_logo }}px;" />
            {% endif %}
        </td>
        <td style="width: 50%; text-align: right;">
            <table style="width: 100%">
                <tr>
                    <td style="font-weight: bold; font-size: 14pt; color: #444; width: 100%;">{{ header|default('')|upper }}</td>
                </tr>
                <tr>
                    <td style="font-size: 14pt; color: #9E9F9E">{{ date }}</td>
                </tr>
                <tr>
                    <td style="font-size: 14pt; color: #9E9F9E">{{ title }}</td>
                </tr>
            </table>
        </td>
    </tr>
</table>
