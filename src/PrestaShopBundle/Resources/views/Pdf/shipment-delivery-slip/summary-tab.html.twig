{# See legacy pdf/shipment-delivery-slip.summary-tab.tpl. #}
<table id="summary-tab" width="100%">
    <tr>
        <th class="header small" valign="middle">{{ 'Order Reference'|trans({}, 'Shop.Pdf') }}</th>
        <th class="header small" valign="middle">{{ 'Order date'|trans({}, 'Shop.Pdf') }}</th>
        <th class="header small" valign="middle">{{ 'Carrier'|trans({}, 'Shop.Pdf') }}</th>
        {% if tracking_number %}
            <th class="header small" valign="middle">{{ 'Tracking number'|trans({}, 'Shop.Pdf') }}</th>
        {% endif %}
    </tr>
    <tr>
        <td class="center small white">{{ order_reference }}</td>
        <td class="center small white">{{ order_date_formatted }}</td>
        <td class="center small white">{{ carrier_name }}</td>
        {% if tracking_number %}
            <td class="center small white">{{ tracking_number }}</td>
        {% endif %}
    </tr>
</table>
