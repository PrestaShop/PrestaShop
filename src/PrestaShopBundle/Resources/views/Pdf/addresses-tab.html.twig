<table id="addresses-tab" cellspacing="0" cellpadding="0">
    <tr>
        <td width="50%">
            {% if delivery_address %}
                <span class="bold">{{ 'Delivery address'|trans({}, 'Shop.Pdf') }}</span><br/><br/>
                {{ delivery_address|raw }}
            {% endif %}
        </td>
        <td width="50%">
            <span class="bold">{{ 'Billing address'|trans({}, 'Shop.Pdf') }}</span><br/><br/>
            {{ invoice_address|raw }}
        </td>
    </tr>
</table>
