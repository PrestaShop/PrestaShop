{% extends '@MailThemes/classic/components/layout.html.twig' %}

{% block content %}
<tr>
  <td align="center" class="titleblock">
    <font size="2" face="{{ languageDefaultFont }}Open-sans, sans-serif" color="#555454">
      <span class="title">{{ 'Hi {firstname} {lastname},'|trans({}, 'Emails.Body', locale) }}</span>
    </font>
  </td>
</tr>
<tr>
  <td class="space_footer">&nbsp;</td>
</tr>
<tr>
  <td class="box" style="border:1px solid #D6D4D4;">
    <table class="table">
      <tr>
        <td width="10">&nbsp;</td>
        <td>
          <font size="2" face="{{ languageDefaultFont }}Open-sans, sans-serif" color="#555454">
            {% if templateType == 'html' %}

              <p style="border-bottom:1px solid #D6D4D4;">
                {{ 'Acknowledgement of receipt of your withdrawal'|trans({}, 'Emails.Body', locale) }}
              </p>

{% endif %}
            <span>
              {{ 'We have received your withdrawal from the contract for the order with the reference'|trans({}, 'Emails.Body', locale) }} <strong>{order_name}</strong>.<br/><br/>
              <strong>{{ 'Date and time of the withdrawal:'|trans({}, 'Emails.Body', locale) }}</strong> {withdrawal_date} ({withdrawal_timezone})<br/>
              <strong>{{ 'Name:'|trans({}, 'Emails.Body', locale) }}</strong> {firstname} {lastname}<br/>
              <strong>{{ 'Email:'|trans({}, 'Emails.Body', locale) }}</strong> {email}<br/>
              <strong>{{ 'Your message:'|trans({}, 'Emails.Body', locale) }}</strong> {message}
            </span>
          </font>
        </td>
        <td width="10">&nbsp;</td>
      </tr>
    </table>
  </td>
</tr>
<tr>
  <td class="space_footer">&nbsp;</td>
</tr>
<tr>
  <td class="linkbelow">
    <font size="2" face="{{ languageDefaultFont }}Open-sans, sans-serif" color="#555454">
      <span>
        {{ 'Please keep this email: it is the acknowledgement of receipt of your withdrawal on a durable medium. We will contact you about the return of the goods and your refund.'|trans({}, 'Emails.Body', locale) }}
      </span>
    </font>
  </td>
</tr>
{% endblock %}
