# Apache 2.2
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files ~ "(?i)^.*\.(jpg|jpeg|gif|png|bmp|tiff|svg|pdf|mov|mpeg|mp4|avi|mpg|wma|flv|webm|ico|webp|avif)$">
        Allow from all
    </Files>
</IfModule>

# Apache 2.4
# Grant by media extension in the URI (works even when intermediate folders are gone).
# Disable rewrite inheritance from the shop root so missing media stay on a lightweight Apache 404
# instead of falling through to index.php.
<IfModule mod_authz_core.c>
    <If "%{REQUEST_URI} =~ m#\.(jpe?g|gif|png|bmp|tiff|svg|pdf|mov|mpeg|mp4|avi|mpg|wma|flv|webm|ico|webp|avif)$#i">
        Require all granted
    </If>
    <Else>
        Require all denied
    </Else>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine Off
</IfModule>

# Overrides root ErrorDocument 404 /index.php?controller=404 for this directory
ErrorDocument 404 "Not Found"

# Prevent SVG files from rendering on the shop origin when opened directly
<IfModule mod_headers.c>
    <FilesMatch "(?i)\.svg$">
        Header set Content-Security-Policy "script-src 'none'"
        Header set Content-Disposition "attachment"
        Header set X-Content-Type-Options "nosniff"
    </FilesMatch>
</IfModule>
